{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concierge Observability Envelopes",
  "type": "object",
  "description": "Trace, event, metric, and audit envelope shapes aligned with Napoleon's Concierge integration package.",
  "definitions": {
    "TraceEnvelope": {
      "type": "object",
      "required": ["trace_id", "parent_trace_id", "actor_id", "request_id", "decision_id", "timestamp"],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "parent_trace_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "AuditEnvelope": {
      "type": "object",
      "required": [
        "audit_id",
        "trace_id",
        "decision_id",
        "actor_id",
        "authority_tier",
        "approval_requirement",
        "evidence_links"
      ],
      "properties": {
        "audit_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "authority_tier": {
          "type": "string"
        },
        "approval_requirement": {
          "type": "string"
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
