{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluator Run Report",
  "type": "object",
  "required": [
    "run_id",
    "mode",
    "scenario_count",
    "score_total",
    "hard_fails",
    "dimension_scores",
    "regressions",
    "recommendations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "napoleon_version": {
      "type": "string"
    },
    "concierge_repo_sha": {
      "type": "string"
    },
    "scenario_count": {
      "type": "integer"
    },
    "score_total": {
      "type": "number"
    },
    "hard_fails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "id", "message"],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "dimension_scores": {
      "type": "object"
    },
    "missing_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message", "previous", "current"],
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "previous": {
            "type": ["number", "integer", "string"]
          },
          "current": {
            "type": ["number", "integer", "string"]
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluationTarget": {
      "type": "object",
      "required": [
        "path",
        "requestKind",
        "operationId",
        "endpointHostRetained",
        "tokenRetained",
        "approvalCaptured",
        "memoryWritePerformed",
        "agentDispatchPerformed",
        "externalSendPerformed"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "requestKind": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "endpointHostRetained": {
          "type": "boolean"
        },
        "tokenRetained": {
          "type": "boolean"
        },
        "requestBodyRetained": {
          "type": "boolean"
        },
        "responseBodyRetained": {
          "type": "boolean"
        },
        "approvalCaptured": {
          "type": "boolean"
        },
        "memoryWritePerformed": {
          "type": "boolean"
        },
        "agentDispatchPerformed": {
          "type": "boolean"
        },
        "externalSendPerformed": {
          "type": "boolean"
        },
        "authorityBoundary": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
